<?xml version="1.0" encoding="utf-8"?>

<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:columnCount="4"
    android:useDefaultMargins="true">

    <TextView
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_columnSpan="4"
        android:gravity="right|center_vertical"
        android:background="#AAAAAA"
        android:text="0"
        android:textSize="30sp"
        android:id="@+id/Texto"

        />

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton1"
        />

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="2"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton2"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="3"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton3"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="/"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botondividir"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="4"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton4"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="5"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton5"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="6"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton6"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="*"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botonpor"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="7"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton7"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="8"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton8"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="9"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton9"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="-"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botonmenos"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/boton0"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="."
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botonpunto"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="="
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botonigual"/>

    <Button
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:background="#6A4FB3"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:id="@+id/botonsuma"/>

    <Button
        android:id="@+id/botoneliminar"
        android:layout_width="75dp"
        android:layout_height="60dp"
        android:layout_row="0"
        android:layout_column="3"
        android:background="#6A4FB3"
        android:text="A/C"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

</GridLayout>